page {
  background: #FBF8F1;
  color: #2B211C;
  font-size: 30rpx;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}
.serif {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
}
.extras { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; margin-top: 18rpx; }
.extras .xlabel { color: #8A7C6F; font-size: 24rpx; }
.stepper { display: inline-flex; align-items: center; gap: 10rpx; font-size: 24rpx; color: #8A7C6F; background: #FFFFFF; border: 2rpx solid #E5DCCC; border-radius: 999rpx; padding: 6rpx 18rpx; }
.stepnum { color: #2B211C; min-width: 1.2em; text-align: center; }
.stepbtn { background: #F3EDE1; color: #2B211C; width: 36rpx; height: 36rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
