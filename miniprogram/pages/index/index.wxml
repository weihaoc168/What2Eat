<template name="tlist">
  <block wx:for="{{items}}" wx:key="name">
    <view class="mlabel" wx:if="{{item.label}}">{{item.label}}</view>
    <view class="slot {{item.sm ? 'sm' : ''}}" bindtap="onCard" data-n="{{item.name}}">
      <image wx:if="{{item.img}}" class="simg" src="{{item.img}}" mode="aspectFill"/>
      <view wx:else class="snoimg">暂无照片</view>
      <view class="sinfo">
        <view class="sname serif">{{item.name}}</view>
        <view class="chips" wx:if="{{item.badge}}"><text class="tag jade">{{item.badge}}</text></view>
        <view class="chips" wx:else><text wx:for="{{item.chips}}" wx:for-item="c" wx:key="t" class="tag {{c.cls}}">{{c.t}}</text></view>
      </view>
    </view>
  </block>
</template>

<template name="tgrid">
  <view class="tilegrid">
    <view class="tile2" wx:for="{{items}}" wx:key="name" bindtap="onCard" data-n="{{item.name}}">
      <image wx:if="{{item.img}}" class="timg" src="{{item.img}}" mode="aspectFill"/>
      <view wx:else class="noimg2 serif">{{item.name}}</view>
      <view class="tb" wx:if="{{item.badge}}"><text class="tag jade">{{item.badge}}</text></view>
      <view class="tn" wx:if="{{item.img}}">{{item.label ? item.label + '·' : ''}}{{item.name}}</view>
    </view>
  </view>
</template>

<template name="tdetail">
  <block wx:for="{{items}}" wx:key="name">
    <view class="mlabel" wx:if="{{item.label}}">{{item.label}}</view>
    <view class="dslot" bindtap="onCard" data-n="{{item.name}}">
      <view class="dname serif">{{item.name}}</view>
      <view class="chips" wx:if="{{item.badge}}"><text class="tag jade">{{item.badge}}</text></view>
      <view class="chips" wx:else><text wx:for="{{item.chips}}" wx:for-item="c" wx:key="t" class="tag {{c.cls}}">{{c.t}}</text></view>
      <view class="dinfo">{{item.info}}</view>
    </view>
  </block>
</template>

<view class="wrap">
  <view class="topbar">
    <text class="today">{{todayLabel}}</text>
    <view class="minibtn" bindtap="onImportOpen">导入相册</view>
  </view>
  <view class="tabs">
    <view class="tab {{mode === 'day' ? 'on' : ''}}" bindtap="onTab" data-m="day">今天</view>
    <view class="tab {{mode === 'week' ? 'on' : ''}}" bindtap="onTab" data-m="week">这周</view>
    <view class="tab {{mode === 'shop' ? 'on' : ''}}" bindtap="onTab" data-m="shop">采购</view>
  </view>

  <view class="extras" wx:if="{{mode !== 'shop'}}">
    <text class="xlabel">晚饭</text>
    <view class="stepper">肉菜 <view class="stepbtn" bindtap="onCount" data-c="meat" data-d="-1">−</view><text class="stepnum">{{cMeat}}</text><view class="stepbtn" bindtap="onCount" data-c="meat" data-d="1">＋</view></view>
    <view class="stepper">蔬菜 <view class="stepbtn" bindtap="onCount" data-c="veg" data-d="-1">−</view><text class="stepnum">{{cVeg}}</text><view class="stepbtn" bindtap="onCount" data-c="veg" data-d="1">＋</view></view>
    <view class="chip {{xSoup ? 'on' : ''}}" bindtap="onExtra" data-k="soup">加汤</view>
    <view class="chip {{xSnack ? 'on' : ''}}" bindtap="onExtra" data-k="snack">加点心</view>
  </view>

  <!-- 今天 -->
  <block wx:if="{{mode === 'day'}}">
    <view class="go" bindtap="onGo">今天吃什么</view>
    <block wx:if="{{dayView}}">
      <view class="vswitch">
        <text class="vlabel">排列</text>
        <view class="vbtn {{dayMode === 'list' ? 'on' : ''}}" bindtap="onLayout" data-t="day" data-v="list">列表</view>
        <view class="vbtn {{dayMode === 'grid' ? 'on' : ''}}" bindtap="onLayout" data-t="day" data-v="grid">网格</view>
        <view class="vbtn {{dayMode === 'detail' ? 'on' : ''}}" bindtap="onLayout" data-t="day" data-v="detail">详细</view>
      </view>
      <view class="card">
        <view class="chead"><text class="ct">早　饭</text><view class="cbtn" bindtap="onReroll" data-k="b">换一换</view></view>
        <template is="t{{dayMode}}" data="{{items: dayView.b}}"/>
        <view class="empty" wx:if="{{!dayView.b.length}}">当前筛选下没有可选的菜</view>
      </view>
      <view class="card">
        <view class="chead"><text class="ct">午　饭</text><text class="chint">带前一晚的肉菜蔬菜</text></view>
        <template wx:if="{{dayView.lunch}}" is="t{{dayMode}}" data="{{items: dayView.lunch}}"/>
        <view class="empty" wx:else>昨晚没有记录。今晚的菜明天会自动变成带饭。</view>
      </view>
      <view class="card">
        <view class="chead"><text class="ct">晚　饭</text><view class="cbtn" bindtap="onReroll" data-k="{{dayView.dk}}">换一换</view></view>
        <template is="t{{dayMode}}" data="{{items: dayView.dinner}}"/>
      </view>
      <view class="card" wx:if="{{dayView.rest}}">
        <view class="chead"><text class="ct">下馆子</text><view class="cbtn" bindtap="onDayRestSwap">换</view></view>
        <view class="slot sm" bindtap="onRestTap" data-n="{{dayView.rest.name}}">
          <view class="rimg">{{dayView.rest.cuisine}}</view>
          <view class="sinfo"><view class="sname serif">{{dayView.rest.name}}</view>
            <view class="chips"><text class="tag jade">{{dayView.rest.tag}}</text><text class="tag" wx:if="{{dayView.rest.km}}">{{dayView.rest.km}}</text></view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- 这周 -->
  <block wx:if="{{mode === 'week'}}">
    <view class="go" bindtap="onGoWeek">这周吃什么</view>
    <block wx:if="{{weekView}}">
      <view class="vswitch">
        <text class="vlabel">排列</text>
        <view class="vbtn {{weekMode === 'list' ? 'on' : ''}}" bindtap="onLayout" data-t="week" data-v="list">列表</view>
        <view class="vbtn {{weekMode === 'grid' ? 'on' : ''}}" bindtap="onLayout" data-t="week" data-v="grid">网格</view>
        <view class="vbtn {{weekMode === 'detail' ? 'on' : ''}}" bindtap="onLayout" data-t="week" data-v="detail">详细</view>
      </view>
      <view class="card" wx:for="{{weekView}}" wx:for-item="d" wx:key="wd">
        <view class="chead"><text class="ct">{{d.wd}}</text><view class="cbtn" bindtap="onWeekReroll" data-i="{{d.i}}">换一换</view></view>
        <view class="mlabel">早</view>
        <template is="t{{weekMode}}" data="{{items: d.b}}"/>
        <view class="mlabel">午</view>
        <template wx:if="{{d.lunch}}" is="t{{weekMode}}" data="{{items: d.lunch}}"/>
        <view class="empty" wx:elif="{{d.i === 0}}">周一带饭暂留空</view>
        <view class="empty" wx:else>前一天没有晚饭记录</view>
        <view class="mlabel">晚</view>
        <template is="t{{weekMode}}" data="{{items: d.dinner}}"/>
        <block wx:if="{{d.rest}}">
          <view class="mlabel">下馆子</view>
          <view class="slot sm">
            <view class="rimg" bindtap="onRestTap" data-n="{{d.rest.name}}">{{d.rest.cuisine}}</view>
            <view class="sinfo" bindtap="onRestTap" data-n="{{d.rest.name}}">
              <view class="sname serif">{{d.rest.name}}</view>
              <view class="chips"><text class="tag jade">{{d.rest.tag}}</text><text class="tag" wx:if="{{d.rest.km}}">{{d.rest.km}}</text></view>
            </view>
            <view class="cbtn" catchtap="onWeekRestSwap" data-i="{{d.i}}">换</view>
          </view>
        </block>
      </view>
    </block>
  </block>

  <!-- 采购 -->
  <block wx:if="{{mode === 'shop'}}">
    <view class="shopbar">
      <view class="chiprow">
        <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{shopView.shops}}" wx:key="s"
          bindtap="onShopChip" data-s="{{item.s}}">{{item.label}}</view>
      </view>
      <view class="acts">
        <view class="minibtn" bindtap="onCopyList">复制清单</view>
        <view class="minibtn" bindtap="onClearBought">清除勾选</view>
      </view>
    </view>
    <view class="gsrc" wx:if="{{!shopView.src}}">先在「今天」或「这周」生成菜单，再来看采购清单。</view>
    <block wx:else>
      <view class="gsrc">{{shopView.src}}・共 {{shopView.count}} 项食材</view>
      <block wx:for="{{shopView.groups}}" wx:for-item="grp" wx:key="cat">
        <view class="gcat serif">{{grp.cat}}</view>
        <view class="grow {{row.bought ? 'bought' : ''}}" wx:for="{{grp.rows}}" wx:for-item="row" wx:key="item"
          bindtap="onGrocRow" data-i="{{row.item}}">
          <text class="gname serif">{{row.item}}</text>
          <text class="gqty">{{row.qty}}</text>
          <view class="gprices">
            <text class="gp {{p.nop ? 'nop' : ''}}" wx:for="{{row.prices}}" wx:for-item="p" wx:key="shop">{{p.shop}} {{p.price}}</text>
          </view>
        </view>
      </block>
      <block wx:if="{{shopView.fruitsAll.length}}">
        <view class="gcat serif">常买水果</view>
        <view class="gsrc">来自 Costco 账单，点选加入清单</view>
        <view class="chiprow" style="margin-top:10rpx">
          <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{shopView.fruitsAll}}" wx:key="cn"
            bindtap="onFruit" data-f="{{item.cn}}">{{item.cn}} ×{{item.times}}</view>
        </view>
      </block>
      <view class="gtotal" wx:if="{{shopView.shops.length}}">
        <text>成本估算 ${{shopView.total}}</text>
        <text class="gnote">{{shopView.priced}}/{{shopView.count}} 项有报价</text>
      </view>
      <view class="gsrc" wx:if="{{shopView.sameday}}">Costco 为同日达（Instacart）参考价，通常比仓库价高 15-20%。</view>
      <view class="gsrc" wx:if="{{shopView.pantryCnt}}">常备调味清点（{{shopView.pantryCnt}} 项）：{{shopView.pantry}}</view>
    </block>

    <block wx:if="{{shopView.spend}}">
      <view class="spend">
        <view class="sph serif">开销分析</view>
        <view class="ssub">{{shopView.spend.source}}・{{shopView.spend.window}}・更新于 {{shopView.spend.updated}}</view>
        <view class="tiles">
          <view class="tile"><view class="tv">${{shopView.spend.avgMonth}}</view><view class="tl">月均支出</view></view>
          <view class="tile"><view class="tv">{{shopView.spend.visits}}</view><view class="tl">月均到店</view></view>
          <view class="tile"><view class="tv">${{shopView.spend.basket}}</view><view class="tl">平均客单</view></view>
          <view class="tile"><view class="tv">{{shopView.spend.foodShare}}%</view><view class="tl">食品占比</view></view>
        </view>
        <view class="schart">
          <view class="sctitle">近 12 个月支出</view>
          <view class="mbars"><view class="mbar" wx:for="{{shopView.spend.bars}}" wx:key="index" style="height:{{item.h}}rpx"></view></view>
          <view class="mlabels"><text>{{shopView.spend.firstYm}}</text><text>峰值 ${{shopView.spend.maxM}}</text><text>{{shopView.spend.lastYm}}</text></view>
        </view>
        <view class="schart">
          <view class="sctitle">类别占比</view>
          <view class="cbar-row" wx:for="{{shopView.spend.cats}}" wx:key="cat">
            <text class="cl">{{item.cat}}</text>
            <view class="cbar-track"><view class="cbar-fill" style="width:{{item.w}}%"></view></view>
            <text class="cv">{{item.v}}</text>
          </view>
        </view>
        <view class="schart">
          <view class="sctitle">高频回购</view>
          <view class="rp-row" wx:for="{{shopView.spend.reps}}" wx:key="cn">
            <text class="rn serif">{{item.cn}}</text><text class="tag">{{item.cat}}</text>
            <text class="rm">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- 筛选 + 总览（非采购页） -->
  <block wx:if="{{mode !== 'shop'}}">
    <view class="filters">
      <view class="fsum" bindtap="onToggleFilters">筛选 <text class="chint">{{fhint}}</text></view>
      <block wx:if="{{filtersOpen}}">
        <view class="fgroup" wx:for="{{filterGroups}}" wx:for-item="grp" wx:key="g">
          <view class="glabel">{{grp.label}}</view>
          <view class="chiprow">
            <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{grp.chips}}" wx:key="o"
              bindtap="onChip" data-g="{{grp.g}}" data-o="{{item.o}}">{{item.o}}</view>
          </view>
        </view>
      </block>
    </view>

    <block wx:for="{{sections}}" wx:for-item="sec" wx:key="meal">
      <view class="sec serif">{{sec.meal}} <text class="cnt">{{sec.cnt}}</text></view>
      <view class="grid">
        <block wx:for="{{sec.cards}}" wx:key="name">
          <view wx:if="{{item.add}}" class="gcard addcard" bindtap="onAddOpen" data-meal="{{item.meal}}">
            <view class="addplus">＋</view><view class="addlabel">添加菜</view>
          </view>
          <view wx:else class="gcard {{item.dim ? 'dim' : ''}}" bindtap="onCard" data-n="{{item.name}}">
            <image wx:if="{{item.img}}" class="gimg" src="{{item.img}}" mode="aspectFill" lazy-load="true"/>
            <view wx:else class="gnoimg serif">{{item.name}}</view>
            <view class="gbody">
              <view class="gcname serif">{{item.name}}</view>
              <view class="chips"><text wx:for="{{item.chips}}" wx:for-item="c" wx:key="t" class="tag {{c.cls}}">{{c.t}}</text></view>
            </view>
          </view>
        </block>
      </view>
    </block>
  </block>

  <view class="footer">
    晚饭默认 = 肉菜 + 蔬菜（数量可调），勾选可加汤加点心；午饭默认带前一晚的肉菜和蔬菜。⚠ 高胆固醇：含蛋黄或虾类。高饱和脂肪：排骨、牛腩、羊肉、鸡翅类。仅为常规食材提示，非医学建议。
  </view>
</view>

<view class="veil" wx:if="{{impShow}}" bindtap="onImportClose">
  <view class="vbox" catchtap="">
    <view class="vbody">
      <view class="vname serif">导入相册</view>
      <view class="imp-section">
        <view class="ilabel">云端相册（整库导入）</view>
        <input class="impinput" value="{{albumUrl}}" bindinput="onAlbumInput" placeholder="粘贴相册分享地址（如 Synology 链接）"/>
        <view class="imp-actions">
          <view class="minibtn" bindtap="onAlbumSave">保存</view>
          <view class="minibtn" bindtap="onAlbumCopy">复制</view>
        </view>
        <view class="ihint">整库识别在自己主机上独立完成：见 github.com/weihaoc168/What2Eat README 第②节，配置后运行 import_album.py 自动认菜入库。</view>
      </view>
      <view class="imp-section">
        <view class="ilabel">手机照片（给单道菜换图/补图）</view>
        <picker mode="selector" range="{{dishNamesArr}}" bindchange="onOvDishPick">
          <view class="impinput pickerv">{{ovDishIdx >= 0 ? dishNamesArr[ovDishIdx] : '点击选择菜名'}}</view>
        </picker>
        <view class="imp-actions">
          <view class="minibtn" bindtap="onOvChoose">从相册选照片</view>
        </view>
        <view class="ihint">照片压缩后存在本机，立即生效，仅本设备可见。</view>
        <view class="ov-row" wx:for="{{ovList}}" wx:key="n">
          <image class="ovimg" src="{{item.img}}" mode="aspectFill"/>
          <text class="serif">{{item.n}}</text>
          <view class="minibtn ovdel" bindtap="onOvDelete" data-n="{{item.n}}">删除</view>
        </view>
      </view>
      <view class="imp-actions" style="justify-content:flex-end;margin-top:20rpx">
        <view class="minibtn" bindtap="onImportClose">关闭</view>
      </view>
    </view>
  </view>
</view>

<view class="veil" wx:if="{{veil}}" bindtap="onCloseVeil">
  <view class="vbox" catchtap="">
    <image wx:if="{{veil.img}}" class="vimg" src="{{veil.img}}" mode="aspectFit"/>
    <view class="vbody">
      <view class="vname serif">{{veil.name}}</view>
      <view class="chips"><text wx:for="{{veil.chips}}" wx:key="t" class="tag {{item.cls}}">{{item.t}}</text></view>
      <view class="vmeta">{{veil.meta}}</view>
      <view class="imp-actions" style="margin-top:20rpx">
        <view class="minibtn" bindtap="onVeilSwap">换照片</view>
        <view wx:if="{{veil.hasOv}}" class="minibtn" bindtap="onVeilUnset">移除本机照片</view>
        <view wx:if="{{veil.custom}}" class="minibtn" bindtap="onDeleteCustom" data-n="{{veil.name}}">删除这道菜</view>
      </view>
    </view>
  </view>
</view>

<view class="veil" wx:if="{{addShow}}" bindtap="onAddClose">
  <view class="vbox" catchtap="">
    <view class="vbody">
      <view class="vname serif">添加菜</view>
      <input class="impinput" style="margin-top:16rpx" value="{{ad.name}}" bindinput="onAdName" placeholder="菜名（必填）"/>
      <view class="fld"><text class="flabel">类别</text>
        <view class="fchips"><view class="chip {{ad.meal === item ? 'on' : ''}}" wx:for="{{adMeals}}" wx:key="*this" bindtap="onAdPick" data-g="meal" data-v="{{item}}">{{item}}</view></view>
      </view>
      <view class="fld"><text class="flabel">菜系</text>
        <view class="fchips"><view class="chip {{ad.cui === item ? 'on' : ''}}" wx:for="{{adCuis}}" wx:key="*this" bindtap="onAdPick" data-g="cui" data-v="{{item}}">{{item}}</view></view>
      </view>
      <view class="fld"><text class="flabel">辣度</text>
        <view class="fchips">
          <view class="chip {{ad.spice === 0 ? 'on' : ''}}" bindtap="onAdPick" data-g="spice" data-v="不辣">不辣</view>
          <view class="chip {{ad.spice === 1 ? 'on' : ''}}" bindtap="onAdPick" data-g="spice" data-v="微辣">微辣</view>
        </view>
      </view>
      <view class="fld"><text class="flabel">营养</text>
        <view class="fchips"><view class="chip {{ad.cat.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{adCats}}" wx:key="*this" bindtap="onAdPick" data-g="cat" data-v="{{item}}">{{item}}</view></view>
      </view>
      <view class="fld"><text class="flabel">食材</text>
        <view class="fchips"><view class="chip {{ad.meat.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{adMeats}}" wx:key="*this" bindtap="onAdPick" data-g="meat" data-v="{{item}}">{{item}}</view></view>
      </view>
      <view class="fld"><text class="flabel">提示</text>
        <view class="fchips"><view class="chip {{ad.flags.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{adFlagOpts}}" wx:key="*this" bindtap="onAdPick" data-g="flags" data-v="{{item}}">{{item}}</view></view>
      </view>
      <view class="imp-actions">
        <view class="minibtn" bindtap="onAdPhoto">{{ad.img ? '已选照片，重选' : '添加照片（可选）'}}</view>
      </view>
      <image wx:if="{{ad.img}}" src="{{ad.img}}" mode="aspectFill" style="width:160rpx;height:160rpx;border-radius:16rpx;margin-top:12rpx"/>
      <view class="imp-actions" style="justify-content:flex-end;margin-top:20rpx">
        <view class="minibtn" bindtap="onAddClose">取消</view>
        <view class="minibtn vsave" bindtap="onAdSave">保存</view>
      </view>
    </view>
  </view>
</view>
