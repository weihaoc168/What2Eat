.wrap { padding: 0 28rpx 100rpx; max-width: 1120rpx; margin: 0 auto; }
.header { display: flex; align-items: baseline; justify-content: space-between; padding: 40rpx 0 8rpx; }
.h1 { font-size: 56rpx; font-weight: 700; letter-spacing: 2rpx; }
.h1::after { content: ""; display: block; width: 130rpx; height: 8rpx; background: #B0382E; border-radius: 4rpx; margin-top: 10rpx; }
.today { color: #8A7C6F; font-size: 26rpx; }

.tabs { display: flex; gap: 14rpx; margin-top: 30rpx; }
.tab {
  flex: 1; text-align: center; padding: 16rpx; font-size: 30rpx; font-weight: 700;
  background: #FFFFFF; color: #8A7C6F; border: 2rpx solid #E5DCCC; border-radius: 20rpx;
}
.tab.on { background: #F3EDE1; color: #2B211C; border-color: #B0382E; box-shadow: inset 0 -6rpx 0 #B0382E; }

.go {
  margin: 24rpx 0 12rpx; padding: 26rpx; text-align: center;
  font-size: 36rpx; font-weight: 700; letter-spacing: 6rpx;
  color: #FFFFFF; background: #B0382E; border-radius: 24rpx;
}

.card {
  background: #FFFFFF; border: 2rpx solid #E5DCCC; border-radius: 24rpx;
  margin-top: 20rpx; overflow: hidden;
}
.chead {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14rpx 24rpx; border-bottom: 2rpx solid #E5DCCC; background: #F3EDE1;
}
.ct { font-size: 28rpx; font-weight: 700; letter-spacing: 6rpx; }
.chint { color: #8A7C6F; font-size: 23rpx; font-weight: 400; }
.cbtn {
  border: 2rpx solid #E5DCCC; color: #8A7C6F; border-radius: 14rpx;
  padding: 6rpx 18rpx; font-size: 24rpx;
}
.mlabel { padding: 10rpx 24rpx 0; color: #8A7C6F; font-size: 23rpx; letter-spacing: 8rpx; border-top: 2rpx dashed #E5DCCC; }
.mlabel:first-of-type { border-top: none; }

.slot { display: flex; gap: 20rpx; padding: 16rpx 24rpx; align-items: center; }
.simg, .snoimg { width: 130rpx; height: 130rpx; border-radius: 18rpx; flex-shrink: 0; background: #F3EDE1; }
.slot.sm .simg, .slot.sm .snoimg, .rimg { width: 96rpx; height: 96rpx; }
.snoimg { display: flex; align-items: center; justify-content: center; color: #8A7C6F; font-size: 22rpx; border: 2rpx dashed #E5DCCC; }
.rimg {
  border-radius: 18rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  background: #E4EEE9; color: #4F7F6B; font-size: 24rpx; font-weight: 700; text-align: center; padding: 4rpx;
}
.sinfo { min-width: 0; flex: 1; }
.sname { font-size: 34rpx; font-weight: 700; }
.slot.sm .sname { font-size: 29rpx; }
.empty { color: #8A7C6F; font-size: 26rpx; padding: 20rpx 24rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 6rpx; }
.tag { font-size: 21rpx; padding: 2rpx 14rpx; border-radius: 999rpx; background: #F3EDE1; color: #8A7C6F; }
.tag.jade { background: #E4EEE9; color: #4F7F6B; }
.tag.warn { background: #F6EBDA; color: #A8681C; }
.tag.spice { background: #F6EBDA; color: #B0382E; }

.filters { margin-top: 36rpx; border: 2rpx solid #E5DCCC; border-radius: 24rpx; background: #FFFFFF; }
.fsum { padding: 20rpx 24rpx; font-weight: 700; display: flex; justify-content: space-between; }
.fgroup { padding: 16rpx 24rpx; border-top: 2rpx solid #E5DCCC; }
.glabel { font-size: 24rpx; color: #8A7C6F; margin-bottom: 12rpx; letter-spacing: 4rpx; }
.chiprow { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  font-size: 26rpx; padding: 8rpx 22rpx; border-radius: 999rpx;
  border: 2rpx solid #E5DCCC; background: #FFFFFF; color: #2B211C;
}
.chip.on { background: #B0382E; color: #FFFFFF; border-color: #B0382E; }

.sec { font-size: 31rpx; letter-spacing: 6rpx; margin: 44rpx 4rpx 6rpx; font-weight: 700; display: flex; align-items: baseline; gap: 16rpx; }
.sec .cnt { color: #8A7C6F; font-size: 24rpx; font-weight: 400; letter-spacing: 0; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.gcard { width: calc(50% - 8rpx); background: #FFFFFF; border: 2rpx solid #E5DCCC; border-radius: 20rpx; overflow: hidden; }
.gimg { width: 100%; height: 240rpx; background: #F3EDE1; }
.gnoimg { width: 100%; height: 240rpx; display: flex; align-items: center; justify-content: center; color: #8A7C6F; background: #F3EDE1; font-size: 34rpx; font-weight: 700; }
.gbody { padding: 12rpx 16rpx 16rpx; }
.gcname { font-size: 29rpx; font-weight: 700; }
.gcard.dim { opacity: .35; }

.shopbar { display: flex; flex-wrap: wrap; gap: 14rpx; align-items: center; justify-content: space-between; margin: 24rpx 0 6rpx; }
.acts { display: flex; gap: 12rpx; }
.minibtn { background: #FFFFFF; border: 2rpx solid #E5DCCC; color: #8A7C6F; border-radius: 14rpx; padding: 8rpx 20rpx; font-size: 24rpx; }
.gsrc { color: #8A7C6F; font-size: 24rpx; margin: 14rpx 4rpx 0; }
.gcat { font-size: 28rpx; letter-spacing: 8rpx; margin: 30rpx 4rpx 10rpx; font-weight: 700; }
.grow {
  display: flex; align-items: center; gap: 16rpx; padding: 14rpx 20rpx;
  background: #FFFFFF; border: 2rpx solid #E5DCCC; border-radius: 18rpx; margin-top: 10rpx;
}
.gname { font-weight: 700; font-size: 29rpx; }
.gqty { color: #8A7C6F; font-size: 24rpx; }
.gprices { margin-left: auto; display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.gp { font-size: 23rpx; white-space: nowrap; }
.gp.nop { color: #8A7C6F; }
.grow.bought { opacity: .4; }
.grow.bought .gname { text-decoration: line-through; }
.gtotal {
  margin-top: 28rpx; padding: 20rpx 24rpx; background: #F3EDE1;
  border: 2rpx solid #E5DCCC; border-radius: 20rpx; font-weight: 700;
  display: flex; justify-content: space-between; align-items: baseline;
}
.gnote { font-weight: 400; font-size: 22rpx; color: #8A7C6F; }

.footer { margin-top: 60rpx; color: #8A7C6F; font-size: 22rpx; line-height: 1.7; border-top: 2rpx solid #E5DCCC; padding-top: 24rpx; }

.veil {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20, 14, 10, .55); z-index: 10;
  display: flex; align-items: center; justify-content: center; padding: 40rpx;
}
.vbox { background: #FFFFFF; border-radius: 28rpx; width: 100%; max-width: 860rpx; max-height: 85vh; overflow-y: auto; }
.vimg { width: 100%; height: 560rpx; background: #F3EDE1; }
.vbody { padding: 24rpx 28rpx 32rpx; }
.vname { font-size: 42rpx; font-weight: 700; }
.vmeta { color: #8A7C6F; font-size: 24rpx; margin-top: 14rpx; }
