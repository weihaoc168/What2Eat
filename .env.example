# ---- 相册来源（Synology Photos 公开分享链接）----
# 分享链接形如 https://<host>:5001/mo/sharing/AbCdEfGh
# SYNO_HOST 填主机名或 IP（不带 https:// 和端口），SHARE_PASSPHRASE 填链接末尾那串字符
SYNO_HOST=192.168.1.10
SYNO_PORT=5001
SHARE_PASSPHRASE=AbCdEfGh

# ---- 识图（import_album.py 需要，仅识图时用）----
# 在 https://platform.claude.com 创建 API Key
ANTHROPIC_API_KEY=sk-ant-api03-xxxx
